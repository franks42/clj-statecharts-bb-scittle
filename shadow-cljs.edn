{:source-paths
 ["src"
  "test"
  "test-scittle/src"]

 :dependencies [[re-frame "1.3.0"
                 :exclusions [[cljsjs/react]
                              [cljsjs/react-dom]
                              [cljsjs/create-react-class]]]
                 [day8.re-frame/test "0.1.5"
                  :exclusions [[re-frame]]]]

 :builds {:ci
          {:target    :karma
           :output-to "test-assets/karma/ci.js"
           :ns-regexp "-test$"}

          :browser-test
          {:target    :browser
           :output-dir "test-scittle/js"
           :asset-path "/js"
           :modules {:main {:entries [statecharts.browser-test-runner]}}}}}
